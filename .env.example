# Environment Variables Template
# Copy this file to .env and fill in your values

# Required: API key for authentication
API_KEY=your-secret-api-key-here

# Database URL - use one of these variable names:

# Option 1: POSTGRES_URI (Supabase default)
POSTGRES_URI=postgresql://user:password@host:port/database

# Option 2: POSTGRES_URL (Render convention)
# POSTGRES_URL=postgresql://user:password@host:port/database

# Option 3: DATABASE_URL (generic fallback)
# DATABASE_URL=postgresql://user:password@host:port/database

# Local development default (if none of the above are set):
# postgresql://localhost/group_project
