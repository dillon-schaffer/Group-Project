# Environment Variables Template
# Copy this file to .env and fill in your values

# Required: API key for authentication
API_KEY=your-secret-api-key-here

# Database URL - choose one of these options:

# Option 1: Supabase (preferred)
POSTGRES_URI=postgresql://user:password@host:port/database

# Option 2: Render or other PostgreSQL provider
# DATABASE_URL=postgresql://user:password@host:port/database

# Option 3: Local development (default if not set)
# DATABASE_URL=postgresql://localhost/group_project
